GROQ_API_KEY=gsk_replace_me

# Optional -- enable OpenRouter (default chat model uses deepseek via OpenRouter).
OPENROUTER_API_KEY=

PELOPS_CHAT_MODEL=openrouter:deepseek/deepseek-v4-flash
PELOPS_RESEARCH_MODEL=groq/compound
PELOPS_RESEARCH_MODEL_FAST=groq/compound-mini

PELOPS_VSTASH_PROJECT=pelops
PELOPS_VSTASH_DB=./data/pelops.db

# Optional -- override wiki vault location. Default is ~/Documents/pelops-wiki/Alita/
PELOPS_WIKI_DIR=

PELOPS_OWNER=Jay
PELOPS_TOPICS=AI agents,LLM tooling,observability

PELOPS_RSS_FEEDS=https://hnrss.org/frontpage,https://simonwillison.net/atom/everything/
PELOPS_BRIEFING_CRON=0 8 * * *
PELOPS_CONSOLIDATE_CRON=0 3 * * *
PELOPS_INGEST_CRON=0 */6 * * *

# Optional -- enable Telegram transport.
# 1. Talk to @BotFather, /newbot, copy the token here.
# 2. Send /start to your new bot.
# 3. Run `python -m pelops.telegram_bot` once; it will log the chat_id, then
#    paste it below and restart.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Optional -- LangSmith tracing. Get an API key from https://smith.langchain.com/
# Once set, every agent.invoke() call streams traces to LangSmith so you can
# inspect tool calls, sub-agent runs, token usage, and intermediate prompts.
# Leave LANGSMITH_TRACING empty (or unset) to disable.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=alita
